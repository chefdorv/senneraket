# Copier en `.env` à la racine. Ce fichier-ci ne contient aucun secret.

# Connection string de la base Supabase, avec le mot de passe.
# Dashboard Supabase > le projet > bouton « Connect » > onglet URI.
# Lue par supabase/apply.mjs — jamais par l'application, qui passe par
# l'API REST et ses clés.
TEKA_DB_URL=postgresql://postgres:MOT_DE_PASSE@db.REF.supabase.co:5432/postgres
